# MySQL connection. Create the database before running migrations.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/stockpilot

# Shopify app credentials from Dev Dashboard (never commit real values)
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SHOPIFY_SCOPES=read_products,read_inventory,read_orders
SHOPIFY_API_VERSION=2026-10
APP_URL=https://your-public-https-tunnel.example
PORT=4000
VITE_API_URL=http://localhost:4000
VITE_SHOPIFY_API_KEY=
MOCK_MODE=true
