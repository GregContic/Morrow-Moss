<article class="product-card"><a href="{{ product.url }}" class="product-card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', alt: product.featured_image.alt }}{% else %}<div class="image-placeholder"><span>GROW SOMETHING GOOD</span></div>{% endif %}{% if product.compare_at_price > product.price %}<span class="product-badge">A LITTLE LESS</span>{% endif %}</a><div class="product-card-meta"><div><a href="{{ product.url }}">{{ product.title }}</a><small>{{ product.type | default: 'A M&M FAVORITE' }}</small></div><span>{{ product.price | money }}</span></div></article>
