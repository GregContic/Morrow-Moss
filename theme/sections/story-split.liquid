<section class="story-split page-width"><div class="story-image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="image-placeholder"><b>Care for<br>what grows.</b></div>{% endif %}</div><div class="story-copy"><p class="eyebrow">A NOTE FROM OUR LITTLE CORNER</p><h2>{{ section.settings.heading | default: 'A greener home is a happier home.' }}</h2><p>{{ section.settings.body | default: 'We believe the best spaces are the ones that grow with you. Every plant is chosen with care, every detail made to bring a little more calm into your everyday.' }}</p><a class="text-link" href="{{ section.settings.link | default: '/pages/our-story' }}">Get to know us ↗</a></div></section>
{% schema %}{"name":"Story split","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"A greener home is a happier home."},{"type":"textarea","id":"body","label":"Body"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Story split"}]}{% endschema %}
