<section class="hero page-width"><div class="hero-copy"><p class="eyebrow">A BREATH OF GREEN</p><h1>Make room<br>for <em>growth.</em></h1><p>Thoughtful plants and everyday rituals to help your space feel a little more alive.</p><a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'Find your plant' }} <span>↗</span></a><div class="hero-note"><span>✳</span> GOOD THINGS TAKE ROOT</div></div><div class="hero-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', alt: section.settings.image.alt }}{% else %}<div class="image-placeholder"><span>01 / GROW SLOW</span><b>Bring the outside<br>in, beautifully.</b></div>{% endif %}<div class="image-caption">THE EVERYDAY BOTANICAL COLLECTION <span>01 — 04</span></div></div></section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"button_label","label":"Button label","default":"Find your plant"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Editorial hero"}]}{% endschema %}
