<section class="page-width section-space cart-page"><p class="eyebrow">YOUR LITTLE GREEN CORNER</p><h1>Your bag<span>.</span></h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-layout"><div class="cart-lines">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}" class="cart-thumb">{{ item.image | image_url: width: 220 | image_tag: alt: item.title }}</a><div class="cart-line-info"><a href="{{ item.url }}">{{ item.product.title }}</a><small>{{ item.variant.title }}</small><label for="Updates_{{ item.key }}">Qty</label><input id="Updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="remove-link" href="{{ item.url_to_remove }}">Remove</a></div><b>{{ item.final_line_price | money }}</b></div>{% endfor %}<button class="text-link update-cart" type="submit" name="update">Update bag ↻</button></div><aside class="cart-summary"><h2>Order summary</h2><div><span>Subtotal</span><b>{{ cart.total_price | money }}</b></div><p>Shipping and taxes calculated at checkout.</p><button class="button button-dark" type="submit" name="checkout">Continue to checkout ↗</button><a href="{{ routes.all_products_collection_url }}">Keep wandering</a></aside></div></form>{% else %}<div class="empty-cart"><p>Your bag is taking a little breather.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Find something lovely ↗</a></div>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
