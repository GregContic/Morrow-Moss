<section class="page-width product-detail"><div class="product-gallery">{% for image in product.images %}<div class="gallery-image">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: image.alt }}</div>{% else %}<div class="image-placeholder"><b>Made to grow with you.</b></div>{% endfor %}</div><div class="product-info"><p class="eyebrow">A LITTLE GREEN GOODNESS</p><h1>{{ product.title }}</h1><p class="product-price">{{ product.selected_or_first_available_variant.price | money }}</p>{% if product.description != blank %}<div class="rte product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect">Choose an option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" min="1" value="1"><button class="button button-dark" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %} <span>↗</span></button>{% endform %}<div class="product-promise"><span>✳ Thoughtfully sourced</span><span>✳ Packed with care</span><span>✳ Here to help it thrive</span></div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
