<section class="bundle-section"><div class="page-width bundle-layout"><div><p class="eyebrow">THE LITTLE GREEN STARTER KIT</p><h2>Build your own<br><em>happy place.</em></h2><p>Pick a plant, give it a home, and add a little care. Your kind of green, your way.</p><div class="bundle-steps"><span>01 <b>Choose a plant</b></span><span>02 <b>Pick a pot</b></span><span>03 <b>Add plant care</b></span></div><p class="bundle-disclaimer">A curated set of individual products, added to your Shopify cart together.</p></div><div class="bundle-builder" data-bundle-builder><div class="bundle-builder-head"><b>Your little bundle</b><span>3 PIECES</span></div>{% assign plant_collection = collections[section.settings.plant_collection] %}{% assign pot_collection = collections[section.settings.pot_collection] %}{% assign care_collection = collections[section.settings.care_collection] %}<div class="bundle-select"><label for="BundlePlant">01 / YOUR PLANT</label><select id="BundlePlant" data-bundle-select>{% for p in plant_collection.products %}<option value="{{ p.selected_or_first_available_variant.id }}" data-price="{{ p.selected_or_first_available_variant.price }}" {% if forloop.first %}selected{% endif %}>{{ p.title }} — {{ p.price | money }}</option>{% endfor %}</select></div><div class="bundle-select"><label for="BundlePot">02 / ITS NEW HOME</label><select id="BundlePot" data-bundle-select>{% for p in pot_collection.products %}<option value="{{ p.selected_or_first_available_variant.id }}" data-price="{{ p.selected_or_first_available_variant.price }}" {% if forloop.first %}selected{% endif %}>{{ p.title }} — {{ p.price | money }}</option>{% endfor %}</select></div><div class="bundle-select"><label for="BundleCare">03 / A LITTLE CARE</label><select id="BundleCare" data-bundle-select>{% for p in care_collection.products %}<option value="{{ p.selected_or_first_available_variant.id }}" data-price="{{ p.selected_or_first_available_variant.price }}" {% if forloop.first %}selected{% endif %}>{{ p.title }} — {{ p.price | money }}</option>{% endfor %}</select></div><div class="bundle-total"><span>Your bundle total</span><b data-bundle-total>{{ 0 | money }}</b></div><button class="button button-dark bundle-add" type="button" data-bundle-add>Add all three to bag <span>↗</span></button><p class="bundle-message" data-bundle-message aria-live="polite"></p></div></div></section>
{% schema %}{"name":"Plant bundle builder","settings":[{"type":"collection","id":"plant_collection","label":"Plant collection"},{"type":"collection","id":"pot_collection","label":"Pot collection"},{"type":"collection","id":"care_collection","label":"Care collection"}],"presets":[{"name":"Plant bundle builder"}]}{% endschema %}
